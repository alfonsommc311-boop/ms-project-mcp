# Copia este archivo a ".env" y rellena tus valores.
# El archivo .env NO debe subirse a git (ya está en .gitignore).

# ====== Cerebro (Claude / Anthropic) — OBLIGATORIO ======
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a usar (por defecto claude-opus-4-8).
BOT_MODEL=claude-opus-4-8
# Mensajes de historial a conservar por conversación.
BOT_HISTORY_LIMIT=40

# ====== Servidor MCP de MS Project ======
# Por defecto el bot lanza "python ../server.py". Sólo cámbialo si tu servidor
# se arranca de otra forma. Ejemplo:
# MSPROJECT_SERVER_CMD=python C:\ruta\a\server.py

# ====== Canal: Telegram (recomendado para empezar) ======
# Token de @BotFather:
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# IDs de chat autorizados (separados por comas o espacios). OBLIGATORIO:
# el bot rechaza a todos si está vacío. Para saber tu ID, escribe a tu bot
# y mira el log, o usa @userinfobot.
TELEGRAM_ALLOWED_IDS=

# ====== Canal: Email (esqueleto) ======
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_USER=tucorreo@gmail.com
# EMAIL_PASSWORD=contraseña-de-aplicacion
# EMAIL_ALLOWED_SENDERS=jefe@empresa.com

# ====== Canal: Slack (esqueleto) ======
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# ====== Canal: WhatsApp (esqueleto) ======
# WHATSAPP_TOKEN=EAAxxxxxxxx
# WHATSAPP_PHONE_ID=1234567890
